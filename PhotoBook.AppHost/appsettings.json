{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "photo-route": {
        "ClusterId": "photo-cluster",
        "Match": {
          "Path": "/api/photo/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/photo/{**catch-all}"
          }
        ]
      },
      "design-route": {
        "ClusterId": "design-cluster",
        "Match": {
          "Path": "/api/design/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/design/{**catch-all}"
          }
        ]
      },
      "layout-route": {
        "ClusterId": "layout-cluster",
        "Match": {
          "Path": "/api/layout/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/layout/{**catch-all}"
          }
        ]
      },
      "render-route": {
        "ClusterId": "render-cluster",
        "Match": {
          "Path": "/api/render/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/render/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "photo-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://photo-service"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "design-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://design-service"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "layout-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://ai-layout-service"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "render-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://render-service"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  }
}
